{
  "name": "kotilo-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @kotilo/kit-desktop dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && pnpm typecheck",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/kit-ui && tsc -p apps/desktop",
    "kit": "tsx --import ./apps/cli/raw-hook.mjs apps/cli/src/main.ts",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @kotilo/kit-desktop tauri build",
    "check-tool": "tsx --import ./apps/cli/raw-hook.mjs packages/kit-tools/scripts/check-tool.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotilo-dev/kotilo-kit.git"
  },
  "homepage": "https://github.com/kotilo-dev/kotilo-kit#readme"
}
