    { "name": "constant TR", "input": "iğne ipliği", "opts": { "mode": "constant", "lang": "tr" }, "expect": { "output": "İĞNE_İPLİĞİ" } },
    { "name": "çok satır", "input": "a b\nc d", "opts": { "mode": "camel" }, "expect": { "output": "aB\ncD" } }
  ]
