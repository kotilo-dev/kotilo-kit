    { "name": "otomatik TR arayüz", "input": "file list", "opts": { "mode": "upper" }, "ctx": { "locale": "tr" }, "expect": { "output": "FİLE LİST" } },
    { "name": "TR başlık", "input": "ılgaz ve iznik", "opts": { "mode": "title", "lang": "tr" }, "expect": { "output": "Ilgaz Ve İznik" } },
    { "name": "EN başlık", "input": "ilgaz and iznik", "opts": { "mode": "title", "lang": "en" }, "expect": { "output": "Ilgaz And Iznik" } },
