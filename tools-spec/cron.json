{
  "tool": "cron",
  "cases": [
    { "name": "her 15 dk", "input": "*/15 * * * *", "ctx": { "now": "2026-01-01T10:07:00Z", "tz": "UTC" },
      "expect": { "output": "Every 15 minutes\n\n// Next 5 runs (UTC)\n2026-01-01 10:15:00 +00:00\n2026-01-01 10:30:00 +00:00\n2026-01-01 10:45:00 +00:00\n2026-01-01 11:00:00 +00:00\n2026-01-01 11:15:00 +00:00" } },
    { "name": "TR açıklama", "input": "0 9 * * 1-5", "opts": { "count": 2 }, "ctx": { "now": "2026-01-02T12:00:00Z", "tz": "Europe/Istanbul", "locale": "tr" },
      "expect": { "contains": ["09:00", "Pazartesi", "2026-01-05 09:00:00 +03:00", "2026-01-06 09:00:00 +03:00", "Sonraki 2 çalışma"] } },
    { "name": "makro", "input": "@daily", "opts": { "count": 1 }, "ctx": { "now": "2026-01-01T10:00:00Z", "tz": "UTC" }, "expect": { "contains": ["2026-01-02 00:00:00 +00:00"] } },
    { "name": "geçersiz", "input": "61 * * * *", "expect": { "error": "error.cron.invalid" } },
    { "name": "boş", "input": " ", "expect": { "error": "error.cron.empty" } }
  ]
}
