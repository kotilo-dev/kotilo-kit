{
  "tool": "password",
  "cases": [
    { "name": "seeded random is deterministic (default 20 chars, all classes)", "input": "", "expect": { "output": "5rb25}ZJuM*el-PW-=:o", "meta": { "count": 1, "entropy": 130, "strength": "tool.password.strength.veryStrong" } } },
    { "name": "length 4 with 4 classes: one of each (l, 5, W, -)", "input": "", "opts": { "length": 4 }, "expect": { "output": "l5W-", "meta": { "entropy": 26, "strength": "tool.password.strength.weak" } } },
    { "name": "digits only", "input": "", "opts": { "length": 8, "lower": false, "upper": false, "symbols": false }, "expect": { "output": "18345692", "meta": { "entropy": 27 } } },
    { "name": "exclude ambiguous, 3 passwords", "input": "", "opts": { "length": 12, "count": 3, "exclude": true }, "expect": { "output": "5A[U.f7;m_Gq\n=fqz[UM&_y52\n(M5C=:z&Yjq5", "meta": { "count": 3 } } },
    { "name": "input text is ignored", "input": "İğdır şehri", "opts": { "length": 4 }, "expect": { "output": "l5W-" } },
    { "name": "TR strength label", "input": "", "opts": { "length": 12, "symbols": false }, "ctx": { "locale": "tr" }, "expect": { "meta": { "strengthLabel": "Güçlü" } } },
    { "name": "passphrase with custom separator", "input": "", "opts": { "kind": "passphrase", "words": 6, "separator": " " }, "expect": { "output": "sing organ indoor cabin cot acorn", "meta": { "entropy": 64, "strength": "tool.password.strength.strong" } } },
    { "name": "passphrase ignores class toggles", "input": "", "opts": { "kind": "passphrase", "lower": false, "upper": false, "digits": false, "symbols": false }, "expect": { "meta": { "count": 1 } } },
    { "name": "no class enabled", "input": "", "opts": { "lower": false, "upper": false, "digits": false, "symbols": false }, "expect": { "error": "error.password.noClass" } }
  ]
}
